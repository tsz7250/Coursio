{
  "name": "Coursio",
  "version": "1.0.0",
  "description": "Get class from yzu course api.",
  "main": "app.js",
  "scripts": {
    "start": "npm run build:renderer && chcp 65001 >nul 2>&1 & electron .",
    "dev": "chcp 65001 >nul 2>&1 & vite build --outDir renderer/dist && electron .",
    "dev:vite": "vite --config vite.config.js",
    "build": "node build.js",
    "build:renderer": "vite build --config vite.config.js",
    "build:win": "vite build --config vite.config.js && electron-builder --win"
  },
  "keywords": [
    "electron"
  ],
  "homepage": "https://github.com/tsz7250/Coursio/",
  "bugs": {
    "url": "https://github.com/tsz7250/Coursio/issues"
  },
  "author": {
    "name": "tsz7250"
  },
  "license": "ISC",
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.4",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "sass": "^1.97.2",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "axios-cookiejar-support": "^6.0.5",
    "browserless": "^10.9.15",
    "cheerio": "^1.1.2",
    "lucide": "^0.575.0",
    "moment": "^2.30.1",
    "node-rsa": "^1.1.1",
    "sqlite3": "^5.1.7",
    "tough-cookie": "^6.0.0",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  }
}
